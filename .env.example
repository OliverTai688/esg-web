# Copy to .env.local for local work; set the same names in Vercel for the test
# site and production. Never commit real values.

# ── Search engines ───────────────────────────────────────────────────────────
# "true" only on the real production domain on launch day (launch checklist 1).
SITE_INDEXABLE=false

# ── Forms (rev2 WP-F: contact #48, email subscribe #50, whitepaper download #53) ──
# Every submission is emailed to MAIL_TO; the site stores nothing.

# Gmail sending (decided 2026-11-09). The Google account that sends, and an app
# password for it: Google Account → Security → 2-Step Verification (must be on)
# → App passwords. On Google Workspace the admin must allow app passwords.
# Required unless FORMS_DRY_RUN=true; without them the forms show an error.
GMAIL_USER=gho001@coesg.tw
GMAIL_APP_PASSWORD=

# Sender name shown in the inbox. The address is always GMAIL_USER.
MAIL_FROM_NAME=共好玟化官網

# Recipient of every form. Defaults to site.supportEmail (gho001@coesg.tw).
MAIL_TO=gho001@coesg.tw

# Testing mode: "true" sends nothing and prints the full email (to, subject,
# reply-to, body) to the server console, then reports success to the form.
# Never leave this on in production: submissions would be lost.
FORMS_DRY_RUN=false

# ── Admin page (/admin/whitepapers: whitepaper download links) ──────────────────
# Shared password for the admin page, at least 8 characters. Unset: admin is locked.
ADMIN_PASSWORD=

# Where the links are saved. On Vercel: Marketplace → Upstash for Redis (free),
# connect it to the project and these are filled in for you (either pair works).
# Locally, without them, links are saved in .data/whitepaper-links.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
